DATABASE_URL="postgresql://kantara:CHANGE_ME@localhost:5432/kantara?schema=public"
SITE_URL="http://localhost:3000"

# Existing PostgreSQL aliases supported; one postgres:// URL is required.
# Runtime prefers DATABASE_URL_POOLED, migrations prefer POSTGRES_URL.
# DATABASE_URL_POOLED=""
# POSTGRES_URL=""
# PRISMA_DATABASE_URL=""

# Real agency (no fictional imports). Apply migrations, then bootstrap once.
AGENCY_MODE="production"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# 32 random bytes, hex encoded. NEVER commit or rotate without re-encrypting
# existing data. Back up securely, set identically on Vercel.
AGENCY_ENCRYPTION_KEY=""

# Fictional local workspaces only; never use for confidential data.
DEMO_STORAGE="file"
DEMO_DATA_DIR=".kantara-demo"

# Separate authenticated local team demo; disabled in production.
DEMO_TEAM_DATA_DIR=".kantara-team"
DEMO_ADMIN_LOGIN="admin.demo"
# Set a unique fictional demo password (12–128 characters) in .env.local.
# Read once when initializing the local team repository; never a hosted account.
DEMO_ADMIN_PASSWORD=""

# Real contact emails. Disabled until ALL values below are configured.
# The sender address must belong to a domain verified in Resend.
CONTACT_ENABLED="false"
RESEND_API_KEY=""
CONTACT_FROM_EMAIL=""
CONTACT_AGENCY_EMAIL=""
# Optional server-only property->recipient overrides. Account notificationEmail
# for the assigned active agent takes precedence; agency email is the fallback.
CONTACT_PROPERTY_RECIPIENTS="{}"
# Free Cloudflare Turnstile: restrict the widget to SITE_URL's hostname.
# This public key is embedded in the build; rebuild after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Set SITE_URL to the exact public HTTPS origin before enabling on Vercel.

# Internal calendar is Asia/Phnom_Penh with one-way ICS export.
# No Google/Microsoft OAuth secrets are needed for this selected mode.

# Optional installed Chrome/Chromium executable for local demonstration PDFs.
# PDF_CHROMIUM_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
